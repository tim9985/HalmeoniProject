# ===================================
# 특정 파일 제외
# ===================================
.DS_Store

# 여기에 특정 파일명 추가 (예: config.json, secret.txt)


# ===================================
# 특정 폴더 제외
# ===================================
logs/
node_modules/
dist/
dist-ssr/
.idea/

# 여기에 특정 폴더 추가 (예: /temp/, /cache/)


# ===================================
# 특정 확장자 전체 제외
# ===================================
*.log
*.local
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 여기에 확장자 패턴 추가 (예: *.tmp, *.bak)


# ===================================
# 특정 폴더 안의 파일만 제외
# ===================================
.vscode/*

# 여기에 특정 폴더 내 파일 패턴 추가 (예: /docs/*.pdf)


# ===================================
# 예외 처리 (무시 규칙에서 제외)
# ===================================
!.vscode/extensions.json

# 여기에 예외 처리할 파일 추가 (예: !important.log)


# ===================================
# 특정 패키지 매니저 관련 로그
# ===================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 여기에 추가 로그 패턴 작성
